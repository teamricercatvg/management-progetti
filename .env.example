# Template preparatorio; servizi da predisporre nella Milestone 1A.
# Compilare .env.local solo con dati dell'istanza dedicata, mai quelli di CDP.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server: stesso endpoint e anon key dell'istanza dedicata.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Solo server: mai NEXT_PUBLIC_ o bundle client.
SUPABASE_SERVICE_ROLE_KEY=
